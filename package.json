{
  "name": "efl-discord-bot",
  "version": "1.0.0",
  "description": "Production-ready Discord Bot for EFL CS2 League match results submission and review",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx tests/runner.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "@prisma/client": "^5.18.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "prisma": "^5.18.0",
    "typescript": "^5.5.4",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsx": "^4.16.2"
  }
}
